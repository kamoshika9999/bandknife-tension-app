<Window x:Class="BandKnifeViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="バンドナイフ張力ビューア" Height="760" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ ヘッダー ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Background="{StaticResource AccentBrush}" Width="4" CornerRadius="2" Margin="0,2,10,2"/>
                <StackPanel>
                    <TextBlock Text="バンドナイフ張力ビューア" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="19" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="データフォルダ:" Style="{StaticResource CaptionText}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="FolderText" Style="{StaticResource CaptionText}"
                                   Foreground="#FF64B5F6" Text="（未設定 — フォルダを選択してください）"
                                   MaxWidth="560" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="フォルダ選択" Click="SelectFolder_Click" Margin="0,0,8,0"/>
                <Button Content="CSV出力" Click="ExportCsv_Click" Margin="0,0,8,0"/>
                <Button Content="更新" Click="Refresh_Click" Style="{StaticResource AccentButton}" MinWidth="76"/>
            </StackPanel>
        </Grid>

        <!-- ============ メインタブ ============ -->
        <TabControl Grid.Row="1">
            <!-- 測定データタブ -->
            <TabItem Header="測定データ">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="最新測定値" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                    <StackPanel x:Name="DashboardPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="張力の推移" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="表示する設備" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="EquipmentCombo" Width="260"
                                                  AutomationProperties.Name="グラフに表示する設備"
                                                  SelectionChanged="EquipmentCombo_SelectionChanged"/>
                                    </StackPanel>
                                </Grid>
                                <scott:WpfPlot Grid.Row="1" x:Name="TrendPlot" MinHeight="230"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="測定履歴" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RecordCountText" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="10,1,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="絞り込む設備" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="FilterCombo" Width="260"
                                              AutomationProperties.Name="履歴を絞り込む設備"
                                              SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" x:Name="HistoryGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日時" Binding="{Binding TimestampText}" Width="160" SortMemberPath="Timestamp"/>
                                    <DataGridTextColumn Header="設備名" Binding="{Binding EquipmentName}" Width="220"/>
                                    <DataGridTextColumn Header="周波数 (Hz)" Binding="{Binding FrequencyText}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="張力 (N)" Binding="{Binding TensionText}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="合否" Width="110" SortMemberPath="Passed">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#334CAF50"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Passed}" Value="False">
                                                                    <Setter Property="Background" Value="#33EF5350"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="13" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✓ OK"/>
                                                                <Setter Property="Foreground" Value="{StaticResource OkTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Passed}" Value="False">
                                                                        <Setter Property="Text" Value="⚠ 要調整"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource NgTextBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="コメント" Binding="{Binding Comment}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 設備管理タブ -->
            <TabItem Header="設備管理">
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="設備マスター" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap">
                                <Run Text="設備の設定は "/>
                                <Run Text="equipment.json" Foreground="#FF64B5F6"/>
                                <Run Text=" で全端末に共有されます。変更後は Android 端末が次回同期時に取り込みます。"/>
                            </TextBlock>
                            <TextBlock x:Name="EquipmentMetaText" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="設備を追加" Click="AddEquipment_Click" Margin="0,0,8,0"/>
                            <Button Content="編集" Click="EditEquipment_Click" Margin="0,0,8,0"/>
                            <Button Content="複製" Click="DuplicateEquipment_Click" Margin="0,0,8,0"/>
                            <Button Content="削除" Click="DeleteEquipment_Click" Margin="0,0,8,0"/>
                            <Button Content="詳細を見る" Click="ViewEquipment_Click" Margin="0,0,8,0"/>
                        </StackPanel>

                        <DataGrid Grid.Row="2" x:Name="EquipmentGrid"
                                  MouseDoubleClick="EquipmentGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="設備名" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="判定" Binding="{Binding ModeText}" Width="56"/>
                                <DataGridTextColumn Header="標準値" Binding="{Binding StandardText}" Width="100"/>
                                <DataGridTextColumn Header="規格範囲" Binding="{Binding SpecText}" Width="130"/>
                                <DataGridTextColumn Header="単位質量" Binding="{Binding MassText}" Width="110"/>
                                <DataGridTextColumn Header="スパン" Binding="{Binding SpanText}" Width="80"/>
                                <DataGridTextColumn Header="幅 (mm)" Binding="{Binding WidthMm}" Width="80"/>
                                <DataGridTextColumn Header="板厚 (mm)" Binding="{Binding ThicknessMm}" Width="90"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding Uuid}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EquipmentStatusText" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="更新者名" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="UpdatedByBox" Width="160" Text="Windowsビューア"/>
                                <Button Content="ドライブに保存" Click="SaveEquipment_Click"
                                        Style="{StaticResource AccentButton}" MinWidth="120" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ============ ステータスバー ============ -->
        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource CaptionText}" Margin="2,10,0,0"/>
    </Grid>
</Window>
